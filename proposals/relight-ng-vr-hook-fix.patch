+#include <array>
+#include <cstdint>
+#include <cstring>
+
+namespace
+{
+	bool RelativeCallTargets(std::uintptr_t a_address, std::uintptr_t a_expectedTarget)
+	{
+		std::array<std::uint8_t, 5> bytes{};
+		std::memcpy(bytes.data(), reinterpret_cast<const void*>(a_address), bytes.size());
+		if (bytes[0] != 0xE8) {
+			return false;
+		}
+
+		std::int32_t displacement{};
+		std::memcpy(&displacement, bytes.data() + 1, sizeof(displacement));
+		const auto target = static_cast<std::uintptr_t>(static_cast<std::intptr_t>(a_address + bytes.size()) + displacement);
+		return target == a_expectedTarget;
+	}
+}
