+		// Confirm every E8 still resolves to mapped GenDynamic before patching.
+		constexpr std::array<std::uintptr_t, 3> callSiteRVAs{
+			0x54FB5C,  // third spell hook, matching the current SSE routine
+			0x547AF6,  // candle light
+			0x779138   // flame spell
+		};
+		std::array<std::uintptr_t, callSiteRVAs.size()> callSites{};
+		for (std::size_t i = 0; i < callSiteRVAs.size(); ++i) {
+			callSites[i] = moduleBase + callSiteRVAs[i];
+			if (!RelativeCallTargets(callSites[i], genDynamic)) {
